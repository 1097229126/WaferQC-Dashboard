# WaferQC-Dashboard 环境配置示例
# 复制此文件为 .env 并修改相应的值

# 数据库配置 - MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的密码
MYSQL_DATABASE=wafer_db
MYSQL_CHARSET=utf8mb4

# 安全配置（生产环境请修改）
SECRET_KEY=请更换为强随机密钥
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 跨域配置
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Project Settings
PROJECT_NAME=WaferQC-Dashboard
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS Settings (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Configuration
# Development: SQLite
DATABASE_URL=sqlite:///./waferqc.db

# Production: PostgreSQL (uncomment and update)
# DATABASE_URL=postgresql://user:password@localhost:5432/waferqc

# Security Settings
# IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-in-production-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
